# Prod-переменные coffeely (скопировать в .env.prod, не коммитить).
# cp .env.prod.example .env.prod && chmod 600 .env.prod

# Домен для Caddy (TLS выпустится автоматически). DNS A-запись → IP VPS.
DOMAIN=api.coffeely.example

# Postgres (сгенерировать пароль: openssl rand -base64 32)
POSTGRES_USER=coffeely
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=coffeely

# Обязательно в prod: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Yandex ID (oauth.yandex.ru → создать приложение)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URL=https://api.coffeely.example/auth/yandex/callback
