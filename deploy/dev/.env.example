# Скопировать в .env: cp .env.example .env
# Реальный .env в .gitignore — секреты в репо не попадают.

# Параметры Postgres-контейнера (dev)
POSTGRES_USER=coffeely
POSTGRES_PASSWORD=coffeely
POSTGRES_DB=coffeely
POSTGRES_PORT=5432

# Параметры backend (используются make run / приложением)
PORT=8080
DATABASE_URL=postgres://coffeely:coffeely@localhost:5432/coffeely?sslmode=disable

# Аутентификация (M2). JWT_SECRET — обязателен в prod, в dev есть дефолт.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Yandex ID (OAuth2). Без них /auth/yandex/start отдаст пустого клиента —
# заполнить перед использованием.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URL=http://localhost:8080/auth/yandex/callback

# Внутренняя админка создателей (/admin на лендинге): вход по строке доступа.
# Пусто — админка отключена (503). В prod — длинный случайный секрет.
ADMIN_CRM_SECRET=
