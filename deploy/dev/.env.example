# Скопировать в .env: cp .env.example .env
# Реальный .env в .gitignore — секреты в репо не попадают.

# Параметры Postgres-контейнера (dev)
POSTGRES_USER=coffeely
POSTGRES_PASSWORD=coffeely
POSTGRES_DB=coffeely
POSTGRES_PORT=5432

# Параметры backend (используются make run / приложением)
PORT=8080
DATABASE_URL=postgres://coffeely:coffeely@localhost:5432/coffeely?sslmode=disable
